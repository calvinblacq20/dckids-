{
  "name": "dckids",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "npm --prefix server ci --omit=dev",
    "start": "npm --prefix server start",
    "vendor:chart": "node -e \"require('fs').copyFileSync('node_modules/chart.js/dist/chart.umd.js','vendor/chart.umd.js')\"",
    "vendor:fa": "node -e \"const f=require('fs'),s='node_modules/@fortawesome/fontawesome-free/';f.copyFileSync(s+'css/all.min.css','vendor/fontawesome/css/all.min.css');['fa-solid-900','fa-regular-400','fa-brands-400','fa-v4compatibility'].forEach(n=>f.copyFileSync(s+'webfonts/'+n+'.woff2','vendor/fontawesome/webfonts/'+n+'.woff2'))\""
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "chart.js": "^4.5.1"
  }
}
